{
  "name": "telesys-erp",
  "version": "0.1.0",
  "private": true,
  "description": "Telesys ERP + PDV Monorepo Foundation",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:desktop": "npm run dev --workspace=@telesys/desktop",
    "build:desktop": "npm run build --workspace=@telesys/desktop",
    "tauri": "npm run tauri --workspace=@telesys/desktop",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "keywords": [
    "erp",
    "pdv",
    "tauri",
    "react",
    "fastapi",
    "postgresql",
    "monorepo"
  ],
  "author": "Telesys Team",
  "license": "UNLICENSED"
}
