# Telesys API Environment Variables
PROJECT_NAME="Telesys ERP API"
API_HOST=0.0.0.0
API_PORT=8000
API_V1_STR=/api/v1
ENVIRONMENT=development

# Database Connection (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=telesys_erp
DATABASE_URL=postgresql://postgres:postgres_dev_password@localhost:5432/telesys_erp

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:1420","tauri://localhost","https://tauri.localhost"]

S3_BUCKET_NAME=nome-do-seu-bucket
S3_ACCESS_KEY=sua_access_key_do_r2
S3_SECRET_KEY=sua_secret_key_do_r2
S3_ENDPOINT_URL=https://<seu_account_id>.r2.cloudflarestorage.com
S3_REGION_NAME=auto