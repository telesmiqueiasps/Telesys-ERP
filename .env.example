# ==========================================
# Telesys ERP + PDV - Environment Variables
# ==========================================
# Este arquivo contém as variáveis de ambiente necessárias para o desenvolvimento.
# Copie este arquivo para .env antes de executar os serviços.
# NUNCA comite credenciais reais ou arquivos .env no repositório.

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_DB=telesys_erp
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres_dev_password@localhost:5432/telesys_erp

# Backend API (FastAPI)
API_HOST=0.0.0.0
API_PORT=8000
API_V1_STR=/api/v1
PROJECT_NAME="Telesys ERP API"
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173","http://localhost:1420","tauri://localhost","https://tauri.localhost"]

# Frontend Desktop (Tauri + Vite)
VITE_API_URL=http://localhost:8000
